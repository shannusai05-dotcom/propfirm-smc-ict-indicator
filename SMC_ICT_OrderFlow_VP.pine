//@version=5
indicator("SMC/ICT + Order Flow Volume Profile [PROPFIRM]", overlay=true, max_bars_back=5000)

// ========== USER INPUTS ==========
group_smc = "SMC Settings"
show_orderblocks = input(true, "Show Order Blocks", group=group_smc)
show_fvg = input(true, "Show Fair Value Gaps (FVG)", group=group_smc)
show_sweeps = input(true, "Show Liquidity Sweeps", group=group_smc)
ob_lookback = input(20, "Order Block Lookback Bars", group=group_smc)

group_ict = "ICT Settings"
show_ote = input(true, "Show OTE Fibonacci Levels", group=group_ict)
show_htf_bias = input(true, "Show HTF Bias (1H/4H)", group=group_ict)
ote_fib_low = input(0.62, "OTE Fib Low %", group=group_ict)
ote_fib_high = input(0.79, "OTE Fib High %", group=group_ict)

group_vp = "Volume Profile Settings"
show_vp = input(true, "Show Volume Profile Nodes", group=group_vp)
vp_lookback = input(50, "VP Lookback Bars", group=group_vp)
high_vol_threshold = input(1.5, "High Volume Multiplier", group=group_vp)

group_alerts = "Alert Settings"
alert_ob = input(true, "Alert on Order Block Touch", group=group_alerts)
alert_fvg = input(true, "Alert on FVG Entry", group=group_alerts)

// ========== COLOR PALETTE ==========
color_ob_bullish = color.new(color.green, 20)
color_ob_bearish = color.new(color.red, 20)
color_fvg_bullish = color.new(color.lime, 30)
color_fvg_bearish = color.new(color.orange, 30)
color_sweep = color.new(color.blue, 40)
color_vpoc = color.new(color.yellow, 0)
color_high_vol = color.new(color.aqua, 50)

// ========== HELPER FUNCTIONS ==========

// Detect Order Blocks (Mitigation Blocks)
f_detect_orderblock(len) =>
    bullish_ob = false
    bearish_ob = false
    ob_high = 0.0
    ob_low = 0.0
    
    for i = 1 to len
        if close[i] > open[i] and close[i+1] < open[i+1]
            bearish_ob := true
            ob_high := high[i]
            ob_low := low[i]
        if close[i] < open[i] and close[i+1] > open[i+1]
            bullish_ob := true
            ob_high := high[i]
            ob_low := low[i]
    
    [bullish_ob, bearish_ob, ob_high, ob_low]

// Detect Fair Value Gap (FVG) - 1m/5m displacement
f_detect_fvg() =>
    bullish_fvg = false
    bearish_fvg = false
    fvg_top = 0.0
    fvg_bottom = 0.0
    
    // Bullish FVG: gap up (low[0] > high[2])
    if low[0] > high[2]
        bullish_fvg := true
        fvg_top := low[0]
        fvg_bottom := high[2]
    
    // Bearish FVG: gap down (high[0] < low[2])
    if high[0] < low[2]
        bearish_fvg := true
        fvg_top := low[2]
        fvg_bottom := high[0]
    
    [bullish_fvg, bearish_fvg, fvg_top, fvg_bottom]

// Detect Liquidity Sweeps (Asian/NY Previous levels)
f_detect_sweep() =>
    sweep_high = high[20:50]
    sweep_low = low[20:50]
    
    is_sweep_high = high > ta.highest(high, 50)
    is_sweep_low = low < ta.lowest(low, 50)
    
    [is_sweep_high, is_sweep_low]

// Volume Profile - Calculate POC & High Volume Nodes
f_volume_profile(len) =>
    avg_vol = ta.sma(volume, len)
    high_vol_node = volume > avg_vol * high_vol_threshold
    vpoc_price = ta.vwap
    
    [vpoc_price, high_vol_node]

// OTE Fibonacci Entry Levels
f_ote_levels(swing_high, swing_low) =>
    range = swing_high - swing_low
    ote_low = swing_high - (range * ote_fib_low)
    ote_high = swing_high - (range * ote_fib_high)
    
    [ote_low, ote_high]

// ========== MAIN LOGIC ==========

// SMC: Order Blocks
[bull_ob, bear_ob, ob_h, ob_l] = f_detect_orderblock(ob_lookback)
if show_orderblocks
    if bull_ob
        box.new(bar_index - 1, ob_h, bar_index, ob_l, border_color=color.green, 
         bgcolor=color_ob_bullish, border_width=2)
    if bear_ob
        box.new(bar_index - 1, ob_h, bar_index, ob_l, border_color=color.red, 
         bgcolor=color_ob_bearish, border_width=2)

// SMC: Fair Value Gaps
[bull_fvg, bear_fvg, fvg_t, fvg_b] = f_detect_fvg()
if show_fvg
    if bull_fvg
        box.new(bar_index - 1, fvg_t, bar_index, fvg_b, border_color=color.lime, 
         bgcolor=color_fvg_bullish, border_width=2)
        if alert_fvg
            alert("BULLISH FVG @ " + str.tostring(fvg_b))
    if bear_fvg
        box.new(bar_index - 1, fvg_t, bar_index, fvg_b, border_color=color.orange, 
         bgcolor=color_fvg_bearish, border_width=2)
        if alert_fvg
            alert("BEARISH FVG @ " + str.tostring(fvg_b))

// SMC: Liquidity Sweeps
[sweep_h, sweep_l] = f_detect_sweep()
if show_sweeps
    if sweep_h
        line.new(bar_index - 5, high, bar_index, high, color=color_sweep, width=2, style=line.style_dashed)
    if sweep_l
        line.new(bar_index - 5, low, bar_index, low, color=color_sweep, width=2, style=line.style_dashed)

// ICT: OTE Fibonacci Levels
htf_high = ta.highest(high, 200)
htf_low = ta.lowest(low, 200)
[ote_l, ote_h] = f_ote_levels(htf_high, htf_low)

if show_ote
    line.new(bar_index - 100, ote_l, bar_index, ote_l, color=color.blue, width=1, style=line.style_dotted)
    line.new(bar_index - 100, ote_h, bar_index, ote_h, color=color.blue, width=1, style=line.style_dotted)
    label.new(bar_index, ote_l, "OTE 62%", color=color.blue, textcolor=color.white, size=size.small)
    label.new(bar_index, ote_h, "OTE 79%", color=color.blue, textcolor=color.white, size=size.small)

// Order Flow: Volume Profile
[vpoc, high_vol] = f_volume_profile(vp_lookback)
if show_vp
    line.new(bar_index - 50, vpoc, bar_index, vpoc, color=color_vpoc, width=2, style=line.style_solid)
    if high_vol
        plotshape(series=high_vol, style=shape.circle, location=location.abovebar, 
         color=color_high_vol, size=size.tiny)

// ========== INVALIDATION & ALERTS ==========

// Invalidation Levels
invalidation_level = bear_ob ? ob_l : bull_ob ? ob_h : na
if not na(invalidation_level)
    line.new(bar_index - 10, invalidation_level, bar_index, invalidation_level, 
     color=color.red, width=1, style=line.style_dotted)
    label.new(bar_index, invalidation_level, "INVALIDATION", color=color.red, textcolor=color.white, size=size.small)

// ========== DASHBOARD INFO ==========
var table info_table = table.new(position.top_right, 3, 5, border_color=color.gray, border_width=1)

table.cell(info_table, 0, 0, "SMC/ICT STATUS", text_color=color.white, bgcolor=color.navy)
table.cell(info_table, 1, 0, bull_ob ? "BULL OB" : bear_ob ? "BEAR OB" : "NONE", text_color=color.white)
table.cell(info_table, 0, 1, "FVG", text_color=color.white)
table.cell(info_table, 1, 1, bull_fvg ? "BULL" : bear_fvg ? "BEAR" : "NONE", text_color=color.white)
table.cell(info_table, 0, 2, "HTF BIAS", text_color=color.white)
table.cell(info_table, 1, 2, close > ta.sma(close, 200) ? "UPTREND" : "DOWNTREND", text_color=color.white)
table.cell(info_table, 0, 3, "VPOC", text_color=color.white)
table.cell(info_table, 1, 3, str.tostring(vpoc, format.price), text_color=color.white)
table.cell(info_table, 0, 4, "R:R ZONE", text_color=color.white)
table.cell(info_table, 1, 4, str.tostring((ote_h - ote_l) * 3, format.price), text_color=color.white)